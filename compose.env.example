# Compose environment. For a Quick Tunnel, APP_ORIGIN is set to the assigned
# https://*.trycloudflare.com hostname by scripts/start-public-demo.sh.
DOMAIN=
APP_ORIGIN=https://replace-with-public-origin.trycloudflare.com
NEXT_PUBLIC_API_URL=
COOKIE_SECURE=true
APP_ENV=production
SERPAPI_KEY=
NEXCONN_APP_KEY=
NEXCONN_APP_SECRET=
NEXCONN_API_BASE_URL=https://api.sg-light-api.com
SESSION_TTL_SECONDS=604800
